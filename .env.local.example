# Скопіюйте у .env.local і заповніть. .env.local нікому не надсилайте.

# Supabase → Project Settings → API (або Data API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Секретний ключ (service_role / secret) — тільки для scripts/seed.mjs, у браузер не потрапляє
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Connect → Session pooler (рядок з паролем бази) — для scripts/migrate.sh
SUPABASE_DB_URL=

# Пароль демо-акаунтів (buyer1/buyer2/admin@demo.local). Він публічний: показується кнопками швидкого входу.
NEXT_PUBLIC_DEMO_PASSWORD=
